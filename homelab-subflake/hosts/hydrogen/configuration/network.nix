{ lib, ... }:
let
  lan = lib.homelab.getNetwork "lan";
  inherit (lib.homelab.getOwnHostConfig) netInterfaces;

  inherit (netInterfaces)
    wan
    lan-1
    lan-2
    lan-3
    lan-bridge
    ;

  lanIP = lib.homelab.getOwnIpInNetwork "lan";

  iot = lib.homelab.getNetwork "iot";
  iotIP = lib.homelab.getOwnIpInNetwork "iot";
  # Name is also used by the gateway firewall and kea
  iotInterfaceName = "iot";

  lanPorts = [
    lan-1
    lan-2
    lan-3
  ];
  # VLAN subinterface per physical port, e.g. `lan-1.50`. Tagged frames are
  # taken off the port before they reach `lan-br`, so nothing listening on
  # `lan-br` (e.g. kea raw sockets) sees IoT traffic.
  iotPortName = port: "${port.name}.${toString iot.settings.vlanId}";

  bridgeBindings =
    lanPorts
    |> map (port: {
      # Binds the devices to the bridge, needs to go first
      # https://wiki.archlinux.org/title/Systemd-networkd#Bind_Ethernet_to_bridge
      name = "1-bridge-bind-${port.name}";
      value = {
        enable = true;
        matchConfig.Name = port.name;
        networkConfig.Bridge = lan-bridge.name;
        vlan = [ (iotPortName port) ];
      };
    })
    |> builtins.listToAttrs;
in
{
  # Disable autogenerated names
  networking.usePredictableInterfaceNames = false;
  networking.useNetworkd = true;

  # Consider any iface to be up => network is up
  systemd.network.wait-online.anyInterface = true;

  systemd.network = {
    links =
      let
        mkLink = link: {
          name = "0-${link.name}";
          value = {
            matchConfig.PermanentMACAddress = link.macAddr;
            linkConfig.Name = link.name;
          };
        };
      in
      builtins.listToAttrs (
        map mkLink [
          wan
          lan-1
          lan-2
          lan-3
        ]
      );
    networks = bridgeBindings // {
      "10-lan" = {
        # The bridge network
        # https://wiki.archlinux.org/title/Systemd-networkd#Bridge_network
        enable = true;
        inherit (lan-bridge) name;
        matchConfig.Name = lan-bridge.name;
        networkConfig = {
          Address = [ (lanIP + lan.settings.netmask) ];
          DNS = [ lan.dnsServers ];
          DHCP = "no";
          # DNSSEC = "yes";
          # DNSOverTLS = "no";
          LinkLocalAddressing = "no";
          DNSDefaultRoute = true;
          Domains = [ lib.homelab.getSettings.publicDomainName ];
        };
      };
      "15-iot-ports" = {
        enable = true;
        matchConfig.Name = lanPorts |> map iotPortName |> lib.concatStringsSep " ";
        networkConfig.Bridge = iotInterfaceName;
      };
      "20-iot" = {
        enable = true;
        name = iotInterfaceName;
        matchConfig.Name = iotInterfaceName;
        networkConfig = {
          Address = [ (iotIP + iot.settings.netmask) ];
          DHCP = "no";
          LinkLocalAddressing = "no";
        };
      };
      "99-wan" = {
        enable = true;
        inherit (wan) name;
        matchConfig.Name = "${wan.name}";
        networkConfig = {
          DHCP = "yes"; # Enables DHCP Client on this interface
          DNS = [ lan.dnsServers ]; # Disable getting DNS from upstream.
          DNSDefaultRoute = false;
        };
      };
    };
    netdevs = {
      lan.netdevConfig = {
        # The interface itself
        # https://wiki.archlinux.org/title/Systemd-networkd#Bridge_interface
        Kind = "bridge";
        Name = lan-bridge.name;
        # bridge between LAN ports
      };
      iot.netdevConfig = {
        # Bridge between per-port IoT VLAN subinterfaces
        Kind = "bridge";
        Name = iotInterfaceName;
      };
    }
    // (
      lanPorts
      |> map (port: {
        name = iotPortName port;
        value = {
          netdevConfig = {
            Kind = "vlan";
            Name = iotPortName port;
          };
          vlanConfig.Id = iot.settings.vlanId;
        };
      })
      |> builtins.listToAttrs
    );
  };
}
